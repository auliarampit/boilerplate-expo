{
  "expo": {
    "name": "boilerplate-expo",
    "slug": "boilerplate-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/daptive-icon.png",
    "scheme": "boilerplateexpo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/daptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-splash-screen",
      "expo-localization",
      "expo-font",
      "@react-native-google-signin/google-signin",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
